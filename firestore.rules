rules_version = '2';
// Identity model: Firebase Auth email/password, email = "<mobile>@<project>.firebaseapp.com".
// admin/{uid} and candidates/{uid} doc ids equal the Auth uid.
// Passwords are NOT stored in Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function myMobile() {
      return request.auth.token.email.split('@')[0];
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    function isCandidate() {
      return signedIn() && exists(/databases/$(database)/documents/candidates/$(request.auth.uid));
    }
    function activeCandidate() {
      return isCandidate()
        && get(/databases/$(database)/documents/candidates/$(request.auth.uid)).data.get('isActive', true) != false
        && get(/databases/$(database)/documents/candidates/$(request.auth.uid)).data.get('isSelected', false) != true;
    }
    // Candidates may edit their profile and deactivate themselves (2-week rule), never reactivate.
    function candidateSelfEditOk() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['experience', 'technologies', 'technology', 'isActive', 'status',
          'selected', 'isSelected', 'selectedDate', 'joiningDate', 'selectedCompany', 'package',
          'selectedPackage', 'hrName', 'hrMobile', 'hrEmail', 'aadhar', 'pan',
          'familyMemberName', 'familyMemberMobile', 'permanentAddress', 'permAddress'])
        && (!keys.hasAny(['isActive', 'status']) || request.resource.data.get('isActive', true) == false);
    }
    function ownsEvent(data) {
      return data.get('candidateMobile', '') == myMobile()
          || data.get('candidateId', '') == request.auth.uid
          || data.get('candidateId', '') == myMobile();
    }

    // Readable candidate passwords, written only by netlify/functions/admin-auth.mjs.
    match /candidateSecrets/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false; // manage admins in the Firebase Console
    }

    match /candidates/{id} {
      // Own doc by id, or by `where('mobile', '==', <own mobile>)` queries.
      allow read: if isAdmin()
        || (signedIn() && (request.auth.uid == id || resource.data.get('mobile', '') == myMobile()));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == id && candidateSelfEditOk());
    }

    // Interview slots: public calendar reads them.
    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (activeCandidate()
            && ownsEvent(request.resource.data)
            && request.resource.data.status == 'Pending Approval'
            && request.resource.data.get('isApproved', false) == false);
      allow update: if isAdmin()
        || (isCandidate() && ownsEvent(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'updatedAt']));
      allow delete: if isAdmin() || (isCandidate() && ownsEvent(resource.data));
    }

    // HR contacts: candidates can add, only admins edit/delete. Not public.
    match /hrs/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || isCandidate();
      allow update, delete: if isAdmin();
    }

    // Candidate profiles + resumes (src/profile, migrated from slot-profile). Admin edits everything; a candidate reads
    // only the profile saved with their login mobile (query must filter on phone), and edits that profile's resume.
    function text(d, key, n) {
      return !(key in d) || (d[key] is string && d[key].size() <= n);
    }
    function maxList(d, key, n) {
      return !(key in d) || (d[key] is list && d[key].size() <= n);
    }
    function validProfile(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && text(d, 'phone', 10) && text(d, 'parentsNo', 10) && text(d, 'spouseNo', 10)
        && text(d, 'reference', 200)
        && maxList(d, 'visitDates', 50) && text(d, 'signDate', 20)
        && text(d, 'passOut', 7)
        && (!('phase' in d) || d.phase in ['inquiry', 'confirmed'])
        && maxList(d, 'tech', 20) && maxList(d, 'companies', 50)
        && (!('hasResume' in d) || d.hasResume is bool) && (!('resumeAt' in d) || d.resumeAt is timestamp)
        && text(d, 'signature', 400000); // drawn signature (PNG data URL), kept small by the app
    }
    function validResume(d) {
      return d.keys().size() <= 40 && text(d, 'name', 200) && text(d, 'phone', 20) && text(d, 'email', 200)
        && maxList(d, 'summary', 30) && maxList(d, 'achievements', 30) && maxList(d, 'skills', 60)
        && maxList(d, 'experience', 30) && maxList(d, 'projects', 30) && maxList(d, 'education', 20);
    }

    match /profiles/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('phone', '') == myMobile());
      allow delete: if isAdmin();
      // A candidate may create a minimal profile for their own mobile (first resume save) and stamp its resume status.
      allow create: if validProfile(request.resource.data) && (isAdmin()
        || (signedIn() && request.resource.data.get('phone', '') == myMobile()
            && request.resource.data.keys().hasOnly(['name', 'phone', 'phase', 'createdAt', 'updatedAt'])));
      allow update: if validProfile(request.resource.data) && (isAdmin()
        || (signedIn() && resource.data.get('phone', '') == myMobile()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasResume', 'resumeAt', 'updatedAt'])));
    }

    match /resumes/{id} {
      allow read: if isAdmin()
        || (signedIn() && get(/databases/$(database)/documents/profiles/$(id)).data.get('phone', '') == myMobile());
      allow delete: if isAdmin();
      // Admin, or the candidate whose profile (same id) carries their login mobile.
      allow create, update: if validResume(request.resource.data) && (isAdmin()
        || (signedIn() && get(/databases/$(database)/documents/profiles/$(id)).data.get('phone', '') == myMobile()));
    }

    // Leaves + slot settings: public calendar reads them.
    match /adminLeaves/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
